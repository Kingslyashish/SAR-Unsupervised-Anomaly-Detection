cff-version: 1.2.0
title: "Site-Dependent VAE and AAE Performance for Unsupervised SAR Oil-Spill Detection"
type: software
message: "If you use this repository, please cite the associated paper."
authors:
  - family-names: "Ashish"
    given-names: "J. Kingsly Jeba"
  - family-names: "Pandey"
